{
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer $env:GH_MCP_TOKEN",
        "X-MCP-Features": "mcp_apps_disable_form_deferral"
      },
      "lifecycle": "lazy"
    },
    "bitbucket": {
      "url": "https://mcp.atlassian.com/v1/mcp",
      "headers": {
        "Authorization": "Basic $env:BB_MCP_TOKEN"
      },
      "lifecycle": "lazy"
    }
  }
}
